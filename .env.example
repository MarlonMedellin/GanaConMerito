# Public runtime configuration (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (NEVER expose in client code or logs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security defaults for production hardening
NODE_ENV=production
APP_ENV=production

# Restrict auth callback destination (comma-separated, no trailing slash)
AUTH_CALLBACK_ALLOWED_ORIGINS=https://cnsc.profemarlon.com

# Optional: strict CORS allowlist for API routes that need cross-origin access
CORS_ALLOWED_ORIGINS=https://cnsc.profemarlon.com

# Temporary QA-only auth bypass for closed beta testing.
# Set to 0 to force Google auth again.
# Enable only in local/QA environments. Production always requires real auth.
GCM_TEST_AUTH_BYPASS=0
GCM_TEST_EMAIL=qa-bypass@ganaconmerito.test
GCM_TEST_PROFILE_ID=00000000-0000-0000-0000-000000000000
