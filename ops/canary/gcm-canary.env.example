# Required deployment controls. This file is a template and contains no secrets.
# Proposed isolated target paths on the VPS:
#   app: /opt/gcm-canary/app
#   env: /opt/gcm-canary/env/gcm-canary.env

# Build identity. Do not replace APP_COMMIT without a release-gate approval.
APP_COMMIT=963d9b899a78c9aaeeb3a74238ce904136ee00ac
APP_BUILD_TIME=SET_AT_APPROVED_CANARY_BUILD

# Runtime isolation. Port 3002 was free during the 2026-08-23 VPS inspection;
# confirm it again immediately before deployment.
CANARY_HOST_PORT=3002

# No Canary hostname or route has been allocated. Replace this placeholder only
# after stakeholder-auth approval and before a routing change is authorized.
CANARY_HOSTNAME=CHANGE_BEFORE_EXPOSURE

# PUBLIC runtime configuration. The URL is pinned to the Canary Candidate only.
NEXT_PUBLIC_SUPABASE_URL=https://dhiytzbwodfvdrnwhkcw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SET_CANDIDATE_ANON_KEY_AT_DEPLOY
NEXT_PUBLIC_APP_COMMIT=963d9b899a78c9aaeeb3a74238ce904136ee00ac
NEXT_PUBLIC_APP_BUILD_TIME=SET_AT_APPROVED_CANARY_BUILD

# SERVER-ONLY SECRETS. Populate only in /opt/gcm-canary/env/gcm-canary.env.
SUPABASE_SERVICE_ROLE_KEY=SET_CANDIDATE_SERVICE_ROLE_KEY_AT_DEPLOY
OPENROUTER_API_KEY=

# SERVER-ONLY CONFIG. No test-auth bypass or LLM shadow is permitted.
AUTH_CALLBACK_ALLOWED_ORIGINS=https://CHANGE_BEFORE_EXPOSURE
CORS_ALLOWED_ORIGINS=https://CHANGE_BEFORE_EXPOSURE
NODE_ENV=production
APP_ENV=production
GCM_TEST_AUTH_BYPASS=0
GCM_TEST_EMAIL=
GCM_TEST_PROFILE_ID=
GCM_TUTOR_LLM_SHADOW=0
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=
