{
  "name": "ganaconmerito",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-build-metadata.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run test:unit",
    "test:unit": "npm run test:dashboard && npm run test:tutor && npm run test:ops && npm run test:security && npm run test:v4-import && npm run test:recent-sprints",
    "test:dashboard": "tsx --test src/lib/dashboard/summary-metrics.test.ts",
    "test:tutor": "tsx --test src/lib/tutor/tutor.test.ts src/lib/tutor/v4-tutor-dossier.test.ts src/lib/tutor/openrouter-provider.test.ts src/lib/tutor/sprint-48-shadow-evaluation.test.ts",
    "test:ops": "tsx --test src/lib/ops/update-jobs.test.ts scripts/ops-update-contract.test.ts scripts/runtime-domain-contract.test.ts",
    "test:security": "tsx --test src/lib/session/practice-question.test.ts scripts/sprint-48-security-contract.test.ts scripts/sprint-48-v4-runtime-contract.test.ts",
    "test:v4-import": "tsx --test scripts/v4-import-plan.test.ts",
    "test:v4-import:db": "tsx scripts/test-v4-atomic-import.ts",
    "test:recent-sprints": "tsx --test src/lib/tutor/normative-source-truth.test.ts scripts/prepare-build-metadata.test.ts scripts/recent-sprints-contract.test.ts",
    "qa:local": "npm run lint && npm run build && npm run test:unit && npm run content:validate",
    "qa:runtime:smoke": "node scripts/qa-runtime-smoke.js",
    "qa:e2e:api": "node scripts/qa-e2e-five-turns.js",
    "qa:e2e:ui": "node scripts/qa-ui-e2e-chromium.js",
    "qa:smoke:postdeploy": "node scripts/qa-smoke-postdeploy.js",
    "qa:security:question-bank": "tsx scripts/verify-question-bank-boundary.ts",
    "check:doc-triggers": "tsx scripts/check-doc-triggers.ts",
    "content:validate": "tsx scripts/validate-question-bank.ts",
    "content:validate:v4": "tsx scripts/validate-question-bank-v4.ts",
    "content:validate:knowledge-targeting": "tsx scripts/validate-knowledge-targeting.ts",
    "content:inventory:v4-sources": "tsx scripts/inventory-v4-source-references.ts",
    "content:import:v4": "tsx scripts/import-question-bank-v4.ts",
    "content:validate:all": "tsx scripts/validate-question-bank.ts --all",
    "content:smoke:active": "tsx scripts/smoke-test-active-question-bank.ts",
    "content:verify:backfill-active": "tsx scripts/verify-active-bank-backfill.ts",
    "content:import:current": "tsx scripts/import-current-question-bank.ts",
    "content:backfill:active": "tsx scripts/backfill-current-corpus-active.ts",
    "content:export:json": "tsx scripts/export-items-to-json.ts --current-corpus",
    "content:export:json:all": "tsx scripts/export-items-to-json.ts --all",
    "content:export:json:check": "tsx scripts/export-items-to-json.ts --check",
    "audit-home": "tsx scripts/audit-home.ts",
    "audit-login": "tsx scripts/audit-login.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "gray-matter": "^4.0.3",
    "next": "^15.5.3",
    "pg": "^8.16.3",
    "playwright": "^1.59.1",
    "supabase": "^2.39.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "zod": "^4.1.11"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
